{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hostinghk.pangxinlabi.top/profile-library/catalog.schema.json",
  "title": "GeeFlow profile library catalog",
  "type": "object",
  "required": ["schemaVersion", "revision", "profiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "revision", "favorite", "deleted", "profile"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "revision": { "type": "integer", "minimum": 0 },
          "favorite": { "type": "boolean" },
          "deleted": { "type": "boolean" },
          "profile": {
            "type": "object",
            "required": ["name", "description", "autoLinkOpen", "singleDoseSettings", "program"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "finishCondition": { "type": ["object", "null"] },
              "autoLinkOpen": { "type": "boolean" },
              "singleDoseSettings": { "type": "object" },
              "program": { "type": "object" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
